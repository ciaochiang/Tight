# Uncomment the line if you want fastlane to automatically update itself
# update_fastlane

default_platform(:ios)

platform :ios do
  desc "Push a new beta build to TestFlight"

  before_all do
    setup_circle_ci
  end

  lane :beta do
    increment_build_number(xcodeproj: "Motic.xcodeproj")
    build_app(scheme: "Motic")
    upload_to_testflight
  end

  desc "Run all the tests"
  lane :test do
    #run_tests(scheme: "Motic")
    #scan

    scan(
      scheme: "Motic",
      clean: true,
      output_types: "xcpretty"
    )
  end
end
